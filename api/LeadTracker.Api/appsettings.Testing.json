      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "None"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5433;Database=leadtracker_test;User Id=test;Password=test;"
  },
