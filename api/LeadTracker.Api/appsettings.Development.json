{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=leadtracker;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "JWT": {
    "SecretKey": "development-secret-key-change-this-in-production-minimum-32-chars",
    "Issuer": "https://localhost:8080",
    "Audience": "https://localhost:3000"
  },
  "Email": {
    "SmtpHost": "mailhog",
    "SmtpPort": 1025,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "dev@leadtracker.local",
    "FromName": "Lead Tracker Dev"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    }
  },
  "Hangfire": {
    "EnableDashboard": true
  },
  "FileStorage": {
    "LocalPath": "./uploads"
  },
  "Features": {
    "EnableSwagger": true,
    "EnableDetailedErrors": true,
    "EnableSeedData": true
  }
}
