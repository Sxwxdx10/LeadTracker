{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=leadtracker;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "JWT": {
    "SecretKey": "development-secret-key-change-this-in-production-minimum-32-chars",
    "Issuer": "http://localhost:8080",
    "Audience": "http://localhost:3000"
  },
  "Email": {
    "SmtpHost": "mailhog",
    "SmtpPort": 1025,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "dev@leadtracker.local",
    "FromName": "Lead Tracker Dev"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/leadtracker-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/leadtracker-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/errors-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithThreadName",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName"
    ]
  },
  "Hangfire": {
    "EnableDashboard": true
  },
  "FileStorage": {
    "LocalPath": "./uploads"
  },
  "Features": {
    "EnableSwagger": true,
    "EnableDetailedErrors": true
  },
  "CORS": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  }
}
