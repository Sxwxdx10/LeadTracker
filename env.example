# Lead Tracker Environment Configuration
# Copy this file to .env and update the values for your environment

# Database Configuration
POSTGRES_DB=leadtracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadtracker

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_ISSUER=https://leadtracker.local
JWT_AUDIENCE=https://leadtracker.local
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# NextAuth Configuration (for web app)
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Email Configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@leadtracker.local
EMAIL_FROM_NAME=Lead Tracker

# Application Configuration
APP_NAME=Lead Tracker
APP_VERSION=1.0.0-dev
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://api:8080

# File Storage
FILE_STORAGE_TYPE=local  # local, azure, aws
FILE_STORAGE_PATH=./uploads
AZURE_STORAGE_CONNECTION_STRING=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring and Logging
SERILOG_MINIMUM_LEVEL=Information
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Hangfire Configuration
HANGFIRE_DASHBOARD_PATH=/hangfire
HANGFIRE_DASHBOARD_TITLE=Lead Tracker Jobs
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=admin

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_HANGFIRE_DASHBOARD=true
ENABLE_HEALTH_CHECKS=true
ENABLE_DETAILED_ERRORS=true

# PgAdmin (optional)
PGADMIN_DEFAULT_EMAIL=admin@leadtracker.local
PGADMIN_DEFAULT_PASSWORD=admin
